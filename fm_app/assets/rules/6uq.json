{
  "source": {
    "id": "6uq",
    "name": "6U音乐",
    "baseUrl": "http://www.6uq.cn",
    "icon": "http://www.6uq.cn/favicon.ico"
  },
  "preflight": {
    "cacheMinutes": 50,
    "steps": [
      {
        "method": "GET",
        "url": "/",
        "responseType": "html",
        "extract": {
          "csrf_token": "@CSS:input[name='csrf_token']@value"
        }
      },
      {
        "method": "POST",
        "url": "/",
        "body": "csrf_token={csrf_token}&human_check=on",
        "contentType": "application/x-www-form-urlencoded"
      }
    ]
  },
  "search": {
    "url": "/so/{keyword}.html",
    "method": "GET",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
    },
    "responseType": "html",
    "listRule": "@CSS:ul li@html",
    "itemRules": {
      "id": "@CSS:div.name a@href && @Regex:/play/([^.]+)",
      "title": "@CSS:div.name a@text && @Regex:《([^》]+)》",
      "artist": "@CSS:div.name a@text && @Regex:^[^《]+##\\\\\\\\u0026||&"
    },
    "pagination": {
      "type": "size",
      "limitValue": 20
    }
  },
  "songDetail": {
    "url": "/js/play.php",
    "method": "POST",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
      "X-Requested-With": "XMLHttpRequest",
      "Referer": "http://www.6uq.cn/"
    },
    "body": "id={id}&type=music",
    "contentType": "application/x-www-form-urlencoded",
    "responseType": "json",
    "listRule": "$",
    "itemRules": {
      "playUrl": "$.url",
      "title": "$.title && @Regex:《([^》]+)》",
      "artist": "$.title && @Regex:^[^《]+",
      "coverUrl": "$.pic"
    }
  },
  "lyric": {
    "url": "/plug/lrcgc.php?id={id}",
    "method": "GET",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
    },
    "responseType": "json",
    "contentRule": "$.lrc"
  }
}
