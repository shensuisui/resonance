{
  "source": {
    "id": "gequbao",
    "name": "歌曲宝",
    "baseUrl": "https://www.gequbao.com",
    "icon": "https://www.gequbao.com/favicon.ico",
    "showInLibrary": true,
    "visible": true
  },
  "search": {
    "url": "/search-fallback?keyword={keyword}&page={page}",
    "method": "GET",
    "responseType": "html",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36",
      "Accept-Language": "zh-CN,zh;q=0.9"
    },
    "listRule": "@CSS:div.row.no-gutters.py-2d5@html",
    "itemRules": {
      "id": "@CSS:a.hover-zoom@href && @Regex:/music/(\\d+)",
      "title": "@CSS:span.text-primary@text##^\\[|\\]$||",
      "artist": "@CSS:small.text-jade@text##^\\[|\\]$||"
    }
  },
  "songDetail": {
    "captcha": {
      "endpoint": "/api/captcha",
      "method": "GET",
      "imagePath": "$.data.img",
      "keyPath": "$.data.key",
      "messagePath": "$.msg",
      "codeField": "captchaCode",
      "keyField": "key",
      "challengeCode": 2
    },
    "steps": [
      {
        "url": "/music/{id}",
        "method": "GET",
        "responseType": "html",
        "headers": {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36",
          "Accept-Language": "zh-CN,zh;q=0.9"
        },
        "extract": {
          "playId": "@Regex:play_id\\\\u0022:\\\\u0022([A-Za-z0-9+/=]{100,})",
          "title": "@CSS:h1.song-title-styled span@text##^\\[|\\]$||",
          "artist": "@CSS:div.song-author-styled@text##^\\[|\\]$||",
          "coverUrl": "@CSS:img.player-cover-img@src",
          "duration": "@Regex:mp3_duration.{0,20}([0-9]{1,2}:[0-9]{2})"
        }
      },
      {
        "url": "/member/common-play-url",
        "method": "POST",
        "responseType": "json",
        "contentType": "application/x-www-form-urlencoded",
        "headers": {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36",
          "X-Requested-With": "XMLHttpRequest",
          "Referer": "https://www.gequbao.com/music/{id}"
        },
        "body": "id={playId}&purpose=play",
        "listRule": "$",
        "itemRules": {
          "playUrl": "$.data.url"
        }
      }
    ]
  },
  "lyric": {
    "url": "/music/{id}",
    "method": "GET",
    "responseType": "html",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36",
      "Accept-Language": "zh-CN,zh;q=0.9"
    },
    "contentRule": "@CSS:div#content-lrc@html##<br\\s*/?>||\\n"
  }
}
